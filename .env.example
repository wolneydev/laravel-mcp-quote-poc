APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8890

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Quote MCP seller identity (local stdio and HTTP). Must be an active VEN-* seller.
MCP_QUOTE_SELLER_ACCOUNT_CODE=VEN-000001

# HTTP Quote MCP clients (Cursor remote MCP, tunnels) need a usable row in
# mcp_client_tokens. Claude Code local uses .mcp.json stdio and does not send
# MCP_QUOTE_TOKEN. Mint a token locally (prints the raw value once):
#   docker compose exec app php artisan mcp:client-token:create --expires-in-days=90
# Put the raw value only in the HTTP client's environment as MCP_QUOTE_TOKEN.
# Do not commit it. Do not put a token hash in this file for Quote MCP auth.

# Administration of MCP client tokens. Laravel stores only the SHA-256 hash.
# Distinct from MCP client tokens. Never commit the raw secret.
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
#   php -r "echo hash('sha256', getenv('MCP_ADMINISTRATION_TOKEN')), PHP_EOL;"
MCP_ADMINISTRATION_TOKEN_HASH=
