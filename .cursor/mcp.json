{
    "mcpServers": {
        "laravel-boost": {
            "command": "docker",
            "args": [
                "compose",
                "exec",
                "-T",
                "app",
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "laravel-application": {
            "command": "docker",
            "args": [
                "compose",
                "exec",
                "-T",
                "app",
                "php",
                "artisan",
                "mcp:start",
                "application"
            ]
        },
        "laravel-quotes": {
            "url": "http://localhost:8890/mcp/quotes",
            "headers": {
                "Authorization": "Bearer ${env:MCP_QUOTE_TOKEN}"
            }
        }
    }
}
